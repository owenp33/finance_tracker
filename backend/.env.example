# Settings for running the backend on the host (python app.py).
# Copy to backend/.env if you need to override anything. Every value is optional:
# the defaults match docker-compose.dev.yml. The Docker production stack uses the
# root .env.example instead.

# Database connection (default: the dev container)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/finance_app

# JWT signing key (a dev default is used when unset; production must set a real one)
# JWT_SECRET_KEY=

# Extra allowed CORS origin, e.g. an ngrok URL when opening the dev app from another device
# FRONTEND_URL=https://your-subdomain.ngrok-free.app
