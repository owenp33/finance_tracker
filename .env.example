# Copy this file to .env and fill in all values before running docker-compose.

# PostgreSQL password — used by both the db container and the backend
POSTGRES_PASSWORD=changeme

# Flask JWT secret — use a long random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Host port the app is reachable on (default 80)
PORT=80

# Optional: number of gunicorn worker processes (default 2)
# GUNICORN_WORKERS=4

# Pre-built image names pushed by GitHub Actions — set these on your server .env
# Replace YOUR_GITHUB_USERNAME with your actual GitHub username
# BACKEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/money-tracker-backend:latest
# FRONTEND_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/money-tracker-frontend:latest
