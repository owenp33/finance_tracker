# Dev-server defaults for `npm start` (committed; holds no secrets; unused by `npm run build`).

# Listen on this machine only. `dev.ps1 -Lan` overrides HOST to open it to your network.
HOST=127.0.0.1

# Required while HOST is a specific address: CRA 5 crashes ("allowedHosts[0] should be a non-empty
# string") whenever package.json also has a "proxy". Binding to 127.0.0.1 already keeps other devices
# out; the host check only guards against DNS rebinding. `dev.ps1 -Lan` turns it back on.
# Vite (backlog #21) removes this trade-off.
DANGEROUSLY_DISABLE_HOST_CHECK=true
